{
  "id": "/",
  "name": "HACKOS — Hackathon Operations System",
  "short_name": "HACKOS",
  "description": "Hackathon Administration, Coordination, and Operations System for organizers, venues, participants, and judges.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#FBF6EE",
  "theme_color": "#131C31",
